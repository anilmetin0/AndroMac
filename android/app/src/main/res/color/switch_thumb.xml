<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 switch thumb colour: on-primary on the primary track, outline when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:color="@color/am_on_primary" />
    <item android:color="@color/am_outline" />
</selector>
