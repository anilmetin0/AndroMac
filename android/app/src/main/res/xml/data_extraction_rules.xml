<?xml version="1.0" encoding="utf-8"?>
<!--
    allowBackup="false" stops the cloud backup but does NOT stop the Android 12+
    DEVICE-TO-DEVICE TRANSFER. The SharedPreferences file carries the static private key
    (wrapped, but still) and the pinned Mac key; copying it to a new phone would silently
    carry the pairing across. The prefs are excluded on both paths: the user re-pairs on the
    new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
