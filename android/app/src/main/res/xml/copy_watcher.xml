<?xml version="1.0" encoding="utf-8"?>
<!-- Only event types and their own text; no window content is ever read (canRetrieveWindowContent off). -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeViewClicked|typeWindowStateChanged|typeNotificationStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/copy_watcher_description" />
