<?xml version="1.0" encoding="utf-8"?>
<!--
    Material 3 switch thumb: 16dp off, 24dp on, coloured by thumbTint (color/switch_thumb).

    Switch places the thumb in a cell of (width - padding) = 26dp, so on a 52dp track the cell
    centres sit at 13 and 39dp. The 3dp padding widens the drawn bounds to 32dp, and the 6dp
    side inset moves each circle to where Material puts it: centre 16dp off (8dp from the
    edge), 36dp on (4dp from the edge).
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list android:paddingLeft="3dp" android:paddingRight="3dp">
            <item android:width="32dp" android:height="32dp" android:drawable="@android:color/transparent" />
            <item android:width="24dp" android:height="24dp" android:gravity="center" android:end="6dp">
                <shape android:shape="oval"><solid android:color="@android:color/white" /></shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list android:paddingLeft="3dp" android:paddingRight="3dp">
            <item android:width="32dp" android:height="32dp" android:drawable="@android:color/transparent" />
            <item android:width="16dp" android:height="16dp" android:gravity="center" android:start="6dp">
                <shape android:shape="oval"><solid android:color="@android:color/white" /></shape>
            </item>
        </layer-list>
    </item>
</selector>
