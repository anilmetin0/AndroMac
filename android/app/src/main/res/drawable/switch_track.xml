<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 switch track, 52x32dp: primary when on; surface-container-highest with a 2dp
     outline when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp" />
            <corners android:radius="16dp" />
            <solid android:color="@color/am_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="52dp" android:height="32dp" />
            <corners android:radius="16dp" />
            <solid android:color="@color/am_surface_container_highest" />
            <stroke android:width="2dp" android:color="@color/am_outline" />
        </shape>
    </item>
</selector>
