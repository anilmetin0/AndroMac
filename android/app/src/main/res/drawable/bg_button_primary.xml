<?xml version="1.0" encoding="utf-8"?>
<!-- A filled accent button with a touch ripple. The equivalent of Material's filled button
     without AndroidX: the shape carries the accent colour, the ripple comes from the system
     highlight. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/am_accent" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</ripple>
