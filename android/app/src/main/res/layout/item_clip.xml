<?xml version="1.0" encoding="utf-8"?>
<!-- One clipboard entry: direction, the text, when; tap copies it, the button sends it to the Mac. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:paddingStart="16dp"
    android:paddingEnd="4dp"
    android:baselineAligned="false">

    <ImageView
        android:id="@+id/clipDirection"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="16dp"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/clipText"
            style="@style/RowTitle"
            android:maxLines="3"
            android:ellipsize="end" />
        <TextView android:id="@+id/clipMeta" style="@style/RowSubtitle" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/clipSend"
        style="@style/IconButton"
        android:layout_marginStart="4dp"
        android:src="@drawable/ic_send"
        android:contentDescription="@string/history_send" />
</LinearLayout>
