<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Top app bar: title, the connection guide, Settings. Same geometry as view_header. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="4dp">

            <TextView
                style="@style/AppBarTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/app_name" />

            <ImageButton
                android:id="@+id/actionHelp"
                style="@style/IconButton"
                android:src="@drawable/ic_info"
                android:contentDescription="@string/help_title" />

            <ImageButton
                android:id="@+id/actionSettings"
                style="@style/IconButton"
                android:src="@drawable/ic_settings"
                android:contentDescription="@string/settings_title" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp">

        <!-- ============ status: tappable once paired, it opens the connection details ============ -->

        <LinearLayout
            android:id="@+id/statusCard"
            style="@style/Card"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:foreground="?android:attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginEnd="16dp"
                    android:background="@drawable/dot_status" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.AM.TitleLarge"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.AM.BodyMedium"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/pair"
                style="@style/PrimaryButton"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="12dp"
                android:text="@string/pair" />
        </LinearLayout>

        <!-- ============ update (only while a newer release is known) ============ -->

        <LinearLayout
            android:id="@+id/updateCard"
            style="@style/Card"
            android:visibility="gone">
            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/update_card_title" />
                    <TextView android:id="@+id/updateBody" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView style="@style/RowIcon" android:src="@drawable/ic_chevron" android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ required permissions: only while one is missing, dismissible ============ -->

        <LinearLayout
            android:id="@+id/permissionCard"
            style="@style/Card"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:minHeight="56dp"
                android:paddingStart="16dp"
                android:paddingEnd="4dp">
                <ImageView style="@style/RowLeadingIcon" android:src="@drawable/ic_warning" android:contentDescription="@null" />
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:textAppearance="@style/TextAppearance.AM.TitleMedium"
                    android:text="@string/permission_banner_title" />
                <ImageButton
                    android:id="@+id/permissionDismiss"
                    style="@style/IconButton"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/permission_banner_dismiss" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowLocalNetwork" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/setup_local_network_title" />
                    <TextView style="@style/RowSubtitle" android:text="@string/setup_local_network_note" />
                </LinearLayout>
                <ImageView style="@style/RowIcon" android:src="@drawable/ic_chevron" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowPostNotif" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/setup_post_notif_title" />
                    <TextView style="@style/RowSubtitle" android:text="@string/setup_post_notif_note" />
                </LinearLayout>
                <ImageView style="@style/RowIcon" android:src="@drawable/ic_chevron" android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowNotifAccess" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/setup_notif_title" />
                    <TextView style="@style/RowSubtitle" android:text="@string/setup_notif_note" />
                </LinearLayout>
                <ImageView style="@style/RowIcon" android:src="@drawable/ic_chevron" android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ connection guide (only while unpaired; later behind the info icon) ============ -->

        <LinearLayout
            android:id="@+id/onboardingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <include layout="@layout/view_onboarding" />
        </LinearLayout>

        <!-- ============ sync: four toggles, no explanatory text ============ -->

        <TextView style="@style/SectionLabel" android:text="@string/section_sync" />

        <LinearLayout style="@style/Card">

            <LinearLayout android:id="@+id/rowBattery" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_battery" />
                <Switch android:id="@+id/swBattery" style="@style/RowSwitch" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowClipboard" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_clipboard" />
                <Switch android:id="@+id/swClipboard" style="@style/RowSwitch" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowNotifications" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_notifications" />
                <Switch android:id="@+id/swNotifications" style="@style/RowSwitch" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowMedia" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_media" />
                <Switch android:id="@+id/swMedia" style="@style/RowSwitch" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ clipboard: the latest entry, and a send row while connected ============ -->

        <TextView style="@style/SectionLabel" android:text="@string/section_clipboard" />

        <LinearLayout style="@style/Card">

            <LinearLayout android:id="@+id/rowClipHistory" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/history_title" />
                    <TextView
                        android:id="@+id/clipHistoryPreview"
                        style="@style/RowSubtitle"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
                <ImageView style="@style/RowIcon" android:src="@drawable/ic_chevron" android:contentDescription="@null" />
            </LinearLayout>

            <Button
                android:id="@+id/rowSendClip"
                style="@style/TonalButton"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="8dp"
                android:text="@string/clip_send_now" />
        </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
