<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <include layout="@layout/view_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp">

        <!-- ============ permission warning (dismissible, only while something is missing) ============ -->

        <LinearLayout
            android:id="@+id/permissionBanner"
            style="@style/Card"
            android:visibility="gone">
            <LinearLayout
                style="@style/Row"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="12dp"
                    android:src="@drawable/ic_warning"
                    android:contentDescription="@null" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/permissionTitle"
                        style="@style/RowTitle"
                        android:text="@string/permission_banner_title" />
                    <TextView android:id="@+id/permissionBody" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView
                    android:id="@+id/permissionDismiss"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="12dp"
                    android:padding="1dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="@string/permission_banner_dismiss" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ status ============ -->

        <LinearLayout
            style="@style/Card"
            android:paddingTop="20dp"
            android:paddingBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/dot_status" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="?android:attr/textColorPrimary"
                        android:text="@string/app_name" />

                    <TextView
                        android:id="@+id/detail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textSize="13sp"
                        android:textColor="?android:attr/textColorSecondary" />
                </LinearLayout>
            </LinearLayout>

            <Button
                android:id="@+id/pair"
                style="@style/PrimaryButton"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="16dp"
                android:text="@string/pair" />
        </LinearLayout>

        <!-- ============ update (only while a newer release is known) ============ -->

        <LinearLayout
            android:id="@+id/updateCard"
            style="@style/Card"
            android:visibility="gone">
            <LinearLayout style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/update_card_title" />
                    <TextView android:id="@+id/updateBody" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ connection guide (only while unpaired) ============ -->

        <LinearLayout
            android:id="@+id/onboardingSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <include layout="@layout/view_onboarding" />
        </LinearLayout>

        <!-- ============ setup (hidden entirely once complete) ============ -->

        <LinearLayout
            android:id="@+id/setupSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView style="@style/SectionLabel" android:text="@string/section_setup" />

            <LinearLayout style="@style/Card">

                <LinearLayout android:id="@+id/rowPostNotif" style="@style/Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="@string/setup_post_notif_title" />
                        <TextView style="@style/RowSubtitle" android:text="@string/setup_post_notif_note" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowNotifAccess" style="@style/Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="@string/setup_notif_title" />
                        <TextView style="@style/RowSubtitle" android:text="@string/setup_notif_note" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowBatteryOpt" style="@style/Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="@string/setup_battery_title" />
                        <TextView style="@style/RowSubtitle" android:text="@string/setup_battery_note" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowDnd" style="@style/Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="@string/setup_dnd_title" />
                        <TextView style="@style/RowSubtitle" android:text="@string/setup_dnd_note" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowOverlay" style="@style/Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="@string/setup_overlay_title" />
                        <TextView style="@style/RowSubtitle" android:text="@string/setup_overlay_note" />
                    </LinearLayout>
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ sync: three toggles, no explanatory text ============ -->

        <TextView style="@style/SectionLabel" android:text="@string/section_sync" />

        <LinearLayout style="@style/Card">

            <LinearLayout android:id="@+id/rowBattery" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_battery" />
                <Switch android:id="@+id/swBattery" style="@style/RowSwitch" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowClipboard" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_clipboard" />
                <Switch android:id="@+id/swClipboard" style="@style/RowSwitch" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowNotifications" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_notifications" />
                <Switch android:id="@+id/swNotifications" style="@style/RowSwitch" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowMedia" style="@style/Row">
                <TextView
                    style="@style/RowTitle"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:text="@string/sync_media" />
                <Switch android:id="@+id/swMedia" style="@style/RowSwitch" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ details live on separate screens ============ -->

        <TextView style="@style/SectionLabel" android:text="@string/section_settings" />

        <LinearLayout style="@style/Card">

            <LinearLayout android:id="@+id/rowNotifSettings" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/settings_notifications" />
                    <TextView android:id="@+id/notifSummary" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowClipSettings" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/settings_clipboard" />
                    <TextView android:id="@+id/clipSummary" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <!-- App preferences after the feature settings. Language is hidden below API 33. -->
            <LinearLayout android:id="@+id/rowLanguage" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/settings_language" />
                    <TextView android:id="@+id/languageSummary" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowFiles" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/settings_files" />
                    <TextView android:id="@+id/fileSummary" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="@null" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowUpdates" style="@style/Row">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView style="@style/RowTitle" android:text="@string/settings_updates" />
                    <TextView android:id="@+id/updatesSummary" style="@style/RowSubtitle" />
                </LinearLayout>
                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="12dp"
                    android:src="@drawable/ic_chevron"
                    android:contentDescription="@null" />
            </LinearLayout>
        </LinearLayout>


        <!-- Version: the first thing asked for in a bug report, so the user need not dig through Settings. -->
        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
