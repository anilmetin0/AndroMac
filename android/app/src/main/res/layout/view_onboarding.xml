<?xml version="1.0" encoding="utf-8"?>
<!--
    The connection guide. Visible only while unpaired.

    Design decision: telling the user "cannot connect" does not help them. Every step shows
    its LIVE state, so which step is stuck can be read at a glance.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <TextView style="@style/SectionLabel" android:text="@string/onboarding_title" />

    <LinearLayout style="@style/Card">

        <LinearLayout style="@style/Row" android:background="@null">
            <ImageView android:id="@+id/step1Icon" style="@style/RowLeadingIcon"
                android:src="@drawable/ic_step_pending" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/RowTitle" android:text="@string/onboarding_step1" />
                <TextView android:id="@+id/step1Status" style="@style/RowSubtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Row" android:background="@null">
            <ImageView android:id="@+id/step2Icon" style="@style/RowLeadingIcon"
                android:src="@drawable/ic_step_pending" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/RowTitle" android:text="@string/onboarding_step2" />
                <TextView android:id="@+id/step2Status" style="@style/RowSubtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout style="@style/Row" android:background="@null">
            <ImageView android:id="@+id/step3Icon" style="@style/RowLeadingIcon"
                android:src="@drawable/ic_step_pending" android:contentDescription="@null" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView style="@style/RowTitle" android:text="@string/onboarding_step3" />
                <TextView android:id="@+id/step3Status" style="@style/RowSubtitle" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout android:id="@+id/rowHelp" style="@style/Row">
            <ImageView style="@style/RowLeadingIcon" android:src="@drawable/ic_help" android:contentDescription="@null" />
            <TextView
                style="@style/RowTitle"
                android:layout_width="0dp"
                android:layout_weight="1"
               
                android:text="@string/onboarding_help" />
            <ImageView style="@style/RowIcon" android:src="@drawable/ic_chevron" android:contentDescription="@null" />
        </LinearLayout>
    </LinearLayout>
</merge>
