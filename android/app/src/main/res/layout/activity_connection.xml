<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <include layout="@layout/view_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp">

            <TextView style="@style/SectionLabel" android:text="@string/connection_section_status" />

            <LinearLayout style="@style/Card">
                <LinearLayout style="@style/Row" android:background="@null">
                    <TextView style="@style/RowTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:text="@string/connection_state" />
                    <TextView android:id="@+id/connectionState" style="@style/RowValue" />
                </LinearLayout>
                <LinearLayout style="@style/Row" android:background="@null">
                    <TextView style="@style/RowTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:text="@string/connection_mac" />
                    <TextView android:id="@+id/connectionMac" style="@style/RowValue" />
                </LinearLayout>
                <LinearLayout style="@style/Row" android:background="@null">
                    <TextView style="@style/RowTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:text="@string/connection_address" />
                    <TextView android:id="@+id/connectionAddress" style="@style/RowValue" />
                </LinearLayout>
            </LinearLayout>

            <TextView style="@style/SectionLabel" android:text="@string/connection_section_options" />

            <LinearLayout style="@style/Card">
                <LinearLayout android:id="@+id/rowAuto" style="@style/Row">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView style="@style/RowTitle" android:text="@string/connection_auto" />
                        <TextView style="@style/RowSubtitle" android:text="@string/connection_auto_note" />
                    </LinearLayout>
                    <Switch android:id="@+id/swAuto" style="@style/RowSwitch" />
                </LinearLayout>

                <LinearLayout android:id="@+id/rowConnectNow" style="@style/Row">
                    <TextView style="@style/RowTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:text="@string/connection_now" />
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="12dp"
                        android:src="@drawable/ic_chevron"
                        android:contentDescription="@null" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout style="@style/Card">
                <LinearLayout android:id="@+id/rowUnpair" style="@style/Row">
                    <TextView style="@style/RowTitle" android:layout_width="0dp" android:layout_weight="1"
                        android:textColor="@color/am_state_alert"
                        android:text="@string/unpair" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
