<?xml version="1.0" encoding="utf-8"?>
<!-- One permission: name and reason on the left; Allow while it is missing, a check once granted. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Row"
    android:paddingStart="16dp"
    android:paddingEnd="12dp"
    android:minHeight="72dp"
    android:baselineAligned="false">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/permTitle" style="@style/RowTitle" />
        <TextView android:id="@+id/permNote" style="@style/RowSubtitle" />
    </LinearLayout>

    <Button
        android:id="@+id/permAllow"
        style="@style/CompactTonalButton"
        android:text="@string/permission_allow" />

    <ImageView
        android:id="@+id/permGranted"
        style="@style/RowIcon"
        android:layout_marginEnd="4dp"
        android:src="@drawable/ic_step_done"
        android:contentDescription="@string/permission_granted"
        android:visibility="gone" />
</LinearLayout>
