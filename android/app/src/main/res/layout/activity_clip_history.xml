<?xml version="1.0" encoding="utf-8"?>
<!-- Recent clipboard entries, newest first. Rows are added in code from item_clip.xml. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scrollRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbarStyle="outsideOverlay"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <include layout="@layout/view_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="8dp">

            <LinearLayout
                android:id="@+id/historyList"
                style="@style/Card" />

            <TextView
                android:id="@+id/historyEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="48dp"
                android:gravity="center"
                android:textAppearance="@style/TextAppearance.AM.BodyLarge"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/history_empty" />

            <TextView
                android:id="@+id/historyNote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textAppearance="@style/TextAppearance.AM.BodySmall"
                android:textColor="?android:attr/textColorSecondary"
                android:text="@string/history_note" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
