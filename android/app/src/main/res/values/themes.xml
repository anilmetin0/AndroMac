<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        The colours come from colors.xml; on Android 12+ devices values-v31 overrides them
        with the Material You system palette. Because everything is read through theme
        attributes there is not a single hex value in the layouts — light/dark and dynamic
        colour come for free.
    -->
    <style name="AppTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:colorAccent">@color/am_accent</item>
        <item name="android:colorBackground">@color/am_background</item>
        <item name="android:colorBackgroundFloating">@color/am_surface</item>
        <item name="android:textColorPrimary">@color/am_on_surface</item>
        <item name="android:textColorSecondary">@color/am_on_surface_variant</item>
        <item name="android:textColorHint">@color/am_on_surface_variant</item>

        <!-- targetSdk 35+ already forces edge-to-edge; we make the bars transparent and
             apply the window insets in code (ui/Insets.kt). -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- The framework ActionBar is disabled: under edge-to-edge it does not push itself
             below the status bar and overlapped the content. view_header.xml draws the header. -->
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- ShareActivity and ClipHelperActivity are invisible to the user: they take focus, do their job, and finish. -->
    <style name="TransparentTheme" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
